# Bot display name used for @-mention detection
BOT_USERNAME=mybot

# Vercel AI Gateway (https://vercel.com/docs/ai-gateway)
# Not needed when deployed on Vercel: the adapter falls back to VERCEL_OIDC_TOKEN
AI_GATEWAY_API_KEY=

# Slack
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=

# Redis (optional; falls back to in-memory state)
REDIS_URL=
